---
/**
 * "Did you know?" flip cards. Each card shows a playful question; tap or
 * press it to flip and reveal the answer. The answer is in the page for
 * search engines and screen readers either way.
 */
import Container from './Container.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  facts: { question: string; answer: string }[];
}

const { facts } = Astro.props;
---

<section class="py-14 md:py-16">
  <Container size="wide">
    <SectionHeading title="Did you know?" lead="Tap a card to find out." align="center" />
    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {facts.map((fact) => (
        <li>
          <button type="button" class="fact" aria-pressed="false">
            <span class="fact__inner">
              <span class="fact__face fact__front">
                <span class="fact__chip">Did you know?</span>
                <span class="fact__question">{fact.question}</span>
                <span class="fact__hint" aria-hidden="true">Tap to flip ↻</span>
              </span>
              <span class="fact__face fact__back">
                <span class="fact__answer">{fact.answer}</span>
              </span>
            </span>
          </button>
        </li>
      ))}
    </ul>
  </Container>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.fact').forEach((card) => {
    card.addEventListener('click', () => {
      const flipped = card.getAttribute('aria-pressed') === 'true';
      card.setAttribute('aria-pressed', String(!flipped));
    });
  });
</script>

<style>
  .fact {
    display: block;
    width: 100%;
    height: 12rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    perspective: 900px;
    text-align: left;
  }

  .fact__inner {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.3, 1.3, 0.5, 1);
  }

  .fact[aria-pressed='true'] .fact__inner {
    transform: rotateY(180deg);
  }

  .fact__face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.4rem;
    border-radius: 1rem;
    backface-visibility: hidden;
  }

  .fact__front {
    border: 1px solid var(--c-line);
    background: var(--c-surface);
  }

  .fact:hover .fact__front {
    border-color: var(--c-brand);
  }

  .fact__back {
    justify-content: center;
    background: var(--c-brand);
    color: var(--c-brand-on);
    transform: rotateY(180deg);
  }

  .fact__chip {
    align-self: flex-start;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--c-brand-soft);
    color: var(--c-link);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .fact__question {
    flex: 1;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--c-ink);
  }

  .fact__hint {
    font-size: 0.8rem;
    color: var(--c-subtle);
  }

  .fact__answer {
    font-family: var(--font-hand);
    font-size: 1.55rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .fact:focus-visible {
    outline: 2px solid var(--c-brand-strong);
    outline-offset: 4px;
    border-radius: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .fact__inner {
      transition: none;
    }
  }
</style>
