---
interface Props {
  /** Narrow suits reading text; wide suits grids. */
  size?: 'narrow' | 'default' | 'wide';
  class?: string;
}

const { size = 'default', class: className = '' } = Astro.props;
const widths = {
  narrow: 'max-w-3xl',
  default: 'max-w-5xl',
  wide: 'max-w-6xl',
};
---

<div class={`mx-auto w-full px-4 sm:px-6 lg:px-8 ${widths[size]} ${className}`}>
  <slot />
</div>
