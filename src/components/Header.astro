---
import { Menu, MessageCircle } from '@lucide/astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import Button from './Button.astro';
import { navLinks } from '../data/nav';
import { whatsappLink, whatsappMessages } from '../utils/whatsapp';

const current = Astro.url.pathname;
const isActive = (href: string) => current === href || current.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-line bg-ground/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="block h-11 w-28 text-ink sm:h-12 sm:w-32" aria-label="Achyutha Music School home">
      <Logo class="h-full w-full" />
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Main">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-sm font-medium no-underline transition-colors hover:text-link',
            isActive(link.href) ? 'text-link' : 'text-ink',
          ]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <div class="hidden sm:block">
        <Button href={whatsappLink(whatsappMessages.general)} external>
          <MessageCircle size={16} aria-hidden="true" /> WhatsApp us
        </Button>
      </div>
      <button
        type="button"
        id="menu-button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line bg-surface text-ink lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Menu size={18} aria-hidden="true" />
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-line bg-ground lg:hidden" aria-label="Mobile">
    <ul class="mx-auto max-w-6xl px-4 py-2 sm:px-6">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="block py-3 text-base font-medium text-ink no-underline">
            {link.label}
          </a>
        </li>
      ))}
      <li class="py-3">
        <Button href={whatsappLink(whatsappMessages.general)} external class="w-full">
          <MessageCircle size={16} aria-hidden="true" /> WhatsApp us
        </Button>
      </li>
    </ul>
  </nav>
</header>

<script>
  const button = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');
  button?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
