---
import { ChevronDown } from '@lucide/astro';

interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-line rounded-2xl border border-line bg-surface">
  {items.map((item) => (
    <details class="group p-5">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-semibold text-ink [&::-webkit-details-marker]:hidden">
        {item.question}
        <ChevronDown size={20} class="shrink-0 text-link transition-transform group-open:rotate-180" aria-hidden="true" />
      </summary>
      <p class="mt-3 leading-relaxed text-muted">{item.answer}</p>
    </details>
  ))}
</div>
