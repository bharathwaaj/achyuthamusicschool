---
/**
 * Small animated drawings that sit along the bottom of a page hero.
 * Each piece moves on its own, slowly, using only transform and opacity
 * so the motion stays smooth. Motion stops for visitors who prefer
 * reduced motion. Use with the hero-surface--art class on the section,
 * which turns off the default string lines.
 */
interface Props {
  variant: 'veena' | 'violin' | 'vocal' | 'team' | 'gallery' | 'contact' | 'about' | 'fees' | 'courses';
}

const { variant } = Astro.props;

// The contact flight path, drawn for a 1200-wide box. A script below
// stretches it to the real content width so it starts at the content's
// left edge and the house ends at its right edge.
const contactPath =
  'M0 64 C 140 30, 300 22, 430 40 S 620 82, 760 66 S 940 34, 1010 52 C 1028 57, 1036 70, 1048 74';

// The dotted trail carries on past the plane's landing point to the
// house wall, so the dots meet the house.
const contactTrailTail = 'S 1090 82, 1110 85';

// Note and leaf shapes shared by the vocal and violin drawings.
const notes = (positions: [number, number][]) => positions;
---

<div class:list={['hero-art', `hero-art--${variant}`]} aria-hidden="true">
  <div class="hero-art__frame">
    {variant === 'vocal' && (
      <svg viewBox="0 0 600 100" preserveAspectRatio="xMinYMax meet">
        <g class="fill">
          <path d="M40 58 L112 58 L105 90 Q76 97 47 90 Z" />
          <ellipse cx="76" cy="95" rx="52" ry="3.5" />
        </g>
        <path class="stroke" d="M112 64 C 132 64, 132 84, 107 86" stroke-width="3" />
        <path class="stroke steam" d="M62 50 C 52 40, 72 32, 62 22 C 55 15, 66 8, 63 3" stroke-width="2.2" />
        <path class="stroke steam steam--late" d="M88 50 C 98 40, 78 33, 92 24 C 104 16, 118 18, 128 24" stroke-width="2.2" />
        {notes([[160, 40], [235, 30], [310, 44], [390, 32], [470, 42]]).map(([x, y], i) => (
          <g transform={`translate(${x} ${y})`}>
            <g class="note" style={`animation-delay: ${i * 1.4}s`}>
              <ellipse class="fill" cx="0" cy="0" rx="6.5" ry="4.6" transform="rotate(-20)" />
              <rect class="fill" x="4.6" y="-24" width="2" height="24" />
              <path class="stroke" d="M5.6 -24 C 13 -20, 15 -13, 11 -7" stroke-width="2" />
            </g>
          </g>
        ))}
      </svg>
    )}

    {variant === 'violin' && (
      <svg viewBox="0 0 600 100" preserveAspectRatio="xMinYMax meet">
        <path
          class="stroke"
          d="M10 34 C 120 34, 160 84, 280 74 S 460 44, 580 64"
          stroke-width="1.5"
          stroke-dasharray="1 9"
          opacity="0.6"
        />
        {[[30, 44, -35], [92, 64, 20], [152, 52, -60]].map(([x, y, r], i) => (
          <g transform={`translate(${x} ${y}) rotate(${r})`}>
            <g class="leaf" style={`animation-delay: ${-i * 1.7}s`}>
              <path class="fill" d="M0 -13 C 9 -8, 9 7, 0 13 C -9 7, -9 -8, 0 -13 Z" />
              <path class="stroke" d="M0 13 L0 19" stroke-width="2" />
            </g>
          </g>
        ))}
        {notes([[230, 74], [305, 62], [385, 58], [465, 48], [545, 58]]).map(([x, y], i) => (
          <g transform={`translate(${x} ${y})`}>
            <g class="note" style={`animation-delay: ${i * 1.4}s`}>
              {i < 2 ? (
                <path class="fill" d="M-1 -6 C 6 -6, 9 2, 2 5 C -5 8, -9 0, -1 -6 Z" transform="rotate(-25)" />
              ) : (
                <ellipse class="fill" cx="0" cy="0" rx="6.5" ry="4.6" transform="rotate(-20)" />
              )}
              <rect class="fill" x="4.6" y="-24" width="2" height="24" />
              <path class="stroke" d="M5.6 -24 C 13 -20, 15 -13, 11 -7" stroke-width="2" />
            </g>
          </g>
        ))}
      </svg>
    )}

    {variant === 'veena' && (
      <svg viewBox="0 0 1200 100" preserveAspectRatio="xMidYMax meet">
        <g class="stroke" stroke-width="1.5">
          <path d="M-2000 90 C -1500 84, -1000 96, -500 90 S 0 84, 300 90 S 900 96, 1200 90 S 2700 84, 3200 90" />
          <path d="M-2000 97 C -1500 93, -1000 101, -500 97 S 0 93, 320 97 S 960 101, 1200 97 S 2700 93, 3200 97" opacity="0.6" />
        </g>
        {[[140, 1], [620, 0.72], [1050, 0.88]].map(([x, s], i) => (
          <g transform={`translate(${x} 0) scale(${s}) translate(-80 0)`}>
            <g class="lotus fill" style={`animation-delay: ${-i * 2}s`}>
              <path d="M80 18 C 69 38, 69 58, 80 72 C 91 58, 91 38, 80 18 Z" />
              <path d="M80 72 C 60 66, 47 48, 45 32 C 60 38, 74 54, 80 72 Z" />
              <path d="M80 72 C 100 66, 113 48, 115 32 C 100 38, 86 54, 80 72 Z" />
              <path d="M80 75 C 55 77, 35 67, 24 54 C 44 53, 64 62, 80 75 Z" />
              <path d="M80 75 C 105 77, 125 67, 136 54 C 116 53, 96 62, 80 75 Z" />
              <ellipse cx="80" cy="82" rx="46" ry="4" />
            </g>
          </g>
        ))}
      </svg>
    )}

    {variant === 'team' && (
      <svg viewBox="0 0 1200 100" preserveAspectRatio="xMaxYMax meet">
        <g class="stroke" stroke-width="1.5">
          <path d="M-3000 55 L4200 55" />
          <path d="M-3000 88 L4200 88" opacity="0.7" />
        </g>
        {[
          [150, 55, false, 1], [195, 55, true, 0.85], [420, 88, false, 1], [610, 55, true, 1],
          [660, 55, false, 0.8], [880, 88, true, 1.1], [1080, 55, false, 1],
        ].map(([x, y, flip, s], i) => (
          <g transform={`translate(${x} ${y}) scale(${flip ? -s : s} ${s})`}>
            <g class="bird-land" style={`animation-delay: ${0.3 + i * 0.35}s`}>
            <g class="bird-bob" style={`animation-delay: ${2.2 + i * 0.35}s; animation-duration: ${3.2 + (i % 3) * 0.6}s`}>
            <g class="bird fill" style={`animation-delay: ${6 + i * 1.9}s`}>
              <path class="wing" d="M-2 -15 C 2 -32, 12 -34, 15 -30 C 9 -24, 4 -18, -2 -15 Z" style={`animation-delay: ${0.3 + i * 0.35}s`} />
              <ellipse cx="0" cy="-11" rx="11" ry="9" />
              <circle cx="9" cy="-19" r="6.5" />
              <path d="M14.5 -21 L21 -18.5 L14.5 -16 Z" />
              <path d="M-8 -14 L-20 -21 L-17 -9 Z" />
              <rect x="-3" y="-3" width="1.6" height="4" />
              <rect x="2" y="-3" width="1.6" height="4" />
            </g>
            </g>
            </g>
          </g>
        ))}
      </svg>
    )}
    {variant === 'gallery' && (
      <svg viewBox="0 0 1200 100" preserveAspectRatio="xMaxYMax meet">
        <path class="stroke" d="M-3000 24 L170 24 Q260.0 40 350 24 Q445.0 40 540 24 Q630.0 40 720 24 Q810.0 40 900 24 Q990.0 40 1080 24 L4200 24" stroke-width="1.5" />
        {[
          [170, -5, 'sun'], [350, 4, 'flower'], [540, -3, 'heart'],
          [720, 5, 'kid'], [900, -4, 'star'], [1080, 3, 'house'],
        ].map(([x, r, kind], i) => (
          <g transform={`translate(${x} 24) rotate(${r})`}>
            <g class="frame-hang" style={`animation-delay: ${0.3 + i * 0.3}s`}>
              <g class="frame-swing" style={`animation-delay: ${-i * 0.9}s; animation-duration: ${4.2 + (i % 3) * 0.7}s`}>
                <rect class="fill" x="-3" y="-7" width="6" height="12" rx="1.5" />
                <path class="stroke" d="M-23 4 L23 5 L24 42 L-24 41 Z" stroke-width="2.2" stroke-linejoin="round" />
                <g class="stroke doodle" stroke-width="2" stroke-linejoin="round">
                  {kind === 'sun' && (
                    <>
                      <circle cx="0" cy="23" r="6" />
                      <path d="M8.5 23.0 L12.5 23.0 M6.0 29.0 L8.8 31.8 M0.0 31.5 L0.0 35.5 M-6.0 29.0 L-8.8 31.8 M-8.5 23.0 L-12.5 23.0 M-6.0 17.0 L-8.8 14.2 M-0.0 14.5 L-0.0 10.5 M6.0 17.0 L8.8 14.2" />
                    </>
                  )}
                  {kind === 'flower' && (
                    <>
                      <path d="M0 23 L0 39 M0 33 C -6 30, -8 34, -6 36 C -4 36, -2 35, 0 33" />
                      <circle cx="0.0" cy="14.8" r="3.2" /><circle cx="4.0" cy="17.7" r="3.2" /><circle cx="2.5" cy="22.4" r="3.2" /><circle cx="-2.5" cy="22.4" r="3.2" /><circle cx="-4.0" cy="17.7" r="3.2" />
                      <circle class="fill" cx="0" cy="19" r="1.8" />
                    </>
                  )}
                  {kind === 'heart' && (
                    <path d="M0 37 C -14 28, -12 13, -4 15 C -1 16, 0 19, 0 21 C 0 19, 1 16, 4 15 C 12 13, 14 28, 0 37 Z" />
                  )}
                  {kind === 'kid' && (
                    <>
                      <circle cx="0" cy="13" r="4.2" />
                      <path d="M0 17 L0 30 M-9 21 L9 23 M0 30 L-6 39 M0 30 L6 39" />
                    </>
                  )}
                  {kind === 'star' && <path d="M0.0 13.0 L2.6 19.4 L9.5 19.9 L4.3 24.4 L5.9 31.1 L0.0 27.5 L-5.9 31.1 L-4.3 24.4 L-9.5 19.9 L-2.6 19.4 Z" />}
                  {kind === 'house' && (
                    <path d="M-10 24 L-10 38 L10 38 L10 24 M-13 25 L0 12 L13 25 M-2 38 L-2 31 L3 31 L3 38" />
                  )}
                </g>
              </g>
            </g>
          </g>
        ))}
      </svg>
    )}
    {variant === 'contact' && (
      <svg class="contact-art" viewBox="0 0 1200 100" preserveAspectRatio="xMinYMax meet" data-base-path={contactPath}>
        <path
          class="stroke contact-trail"
          d={`${contactPath} ${contactTrailTail}`}
          data-tail={contactTrailTail}
          stroke-width="2.4"
          stroke-dasharray="1 10"
          opacity="0.7"
        />
        <g class="contact-house">
        <g class="fill">
          <path d="M1110 64 L1110 93 L1162 93 L1162 64 L1136 42 Z" />
          <rect x="1149" y="44" width="7" height="14" />
        </g>
        <rect class="window" x="1116" y="68" width="11" height="9" rx="1" />
        <rect class="door" x="1138" y="76" width="10" height="17" rx="1" />
        <path class="stroke smoke" d="M1152 40 C 1146 32, 1158 26, 1152 18" stroke-width="2" />
        <path class="stroke smoke smoke--late" d="M1154 40 C 1162 32, 1150 26, 1158 18" stroke-width="2" />
        </g>
        <g class="plane" style={`offset-path: path('${contactPath}');`}>
          <g transform="scale(1.45) rotate(-8) translate(27 1)">
            <path class="fill" d="M24 -1 L-20 -17 L-6 -1 Z" />
            <path class="fill" d="M24 -1 L-6 -1 L-2 8 Z" opacity="0.45" />
            <path class="fill" d="M24 -1 L-6 -1 L-18 6 Z" opacity="0.7" />
            <path class="stroke" d="M24 -1 L-6 -1" stroke-width="1.2" opacity="0.5" />
          </g>
        </g>
      </svg>
    )}
    {variant === 'about' && (
      <svg class="about-art" viewBox="0 0 640 100" preserveAspectRatio="xMinYMax meet">
        <path class="stroke about-ground" d="M0 93 L640 93" stroke-width="1.5" opacity="0.6" />
        <g class="about-stage" data-left="10" data-right="22">
        <g class="grow" style="animation-delay: 0.2s">
          <ellipse class="fill" cx="16" cy="89" rx="6" ry="4" />
        </g>
        </g>
        <g class="about-stage" data-left="66" data-right="90">
        <g class="grow" style="animation-delay: 0.55s">
          <g class="sway" style="animation-delay: 1.70s">
            <path class="stroke" d="M78 93 L78 77" stroke-width="2.2" />
            <path class="fill" d="M78 80 C 69 79, 66 71, 71 69 C 76 70, 78 75, 78 80 Z" />
            <path class="fill" d="M78 78 C 87 77, 90 69, 85 67 C 80 68, 78 73, 78 78 Z" />
          </g>
        </g>
        </g>
        <g class="about-stage" data-left="135" data-right="165">
        <g class="grow" style="animation-delay: 0.9s">
          <g class="sway" style="animation-delay: 2.05s">
            <path class="stroke" d="M150 93 L150 63" stroke-width="2.6" />
            <path class="fill" d="M150 84 C 139 83, 135 74, 141 72 C 147 73, 150 79, 150 84 Z" />
            <path class="fill" d="M150 78 C 161 77, 165 68, 159 66 C 153 67, 150 73, 150 78 Z" />
            <path class="fill" d="M150 68 C 141 66, 139 58, 144 56 C 149 58, 150 63, 150 68 Z" />
            <path class="fill" d="M150 66 C 158 64, 161 57, 156 55 C 151 57, 150 61, 150 66 Z" />
          </g>
        </g>
        </g>
        <g class="about-stage" data-left="219" data-right="258">
        <g class="grow" style="animation-delay: 1.25s">
          <g class="sway" style="animation-delay: 2.40s">
            <path class="fill" d="M236 93 L236 60 L240 60 L240 93 Z" />
            <circle class="fill" cx="238" cy="48" r="11" />
            <circle class="fill" cx="228" cy="56" r="8" />
            <circle class="fill" cx="249" cy="55" r="8.5" />
          </g>
        </g>
        </g>
        <g class="about-stage" data-left="322" data-right="380">
        <g class="grow" style="animation-delay: 1.6s">
          <g class="sway" style="animation-delay: 2.75s">
            <path class="fill" d="M345 93 C 347 80, 346 62, 347 50 L 353 50 C 354 62, 353 80, 356 93 Z" />
            <path class="stroke" d="M349 64 L336 52 M351 60 L365 48" stroke-width="2.5" />
            <circle class="fill" cx="350" cy="34" r="15" />
            <circle class="fill" cx="333" cy="44" r="11" />
            <circle class="fill" cx="368" cy="42" r="12" />
            <circle class="fill" cx="342" cy="27" r="9" />
            <circle class="fill" cx="360" cy="25" r="9" />
          </g>
        </g>
        </g>
        <g class="about-stage about-stage--optional" data-left="398" data-right="466">
        <g class="grow" style="animation-delay: 1.95s">
          <g class="sway" style="animation-delay: 3.10s">
            <path class="fill" d="M425 93 C 428 78, 426 58, 428 44 L 436 44 C 437 58, 436 78, 439 93 Z" />
            <path class="stroke" d="M430 62 L414 48 M433 58 L450 44" stroke-width="2.8" />
            <circle class="fill" cx="431" cy="26" r="18" />
            <circle class="fill" cx="411" cy="38" r="13" />
            <circle class="fill" cx="452" cy="36" r="14" />
            <circle class="fill" cx="420" cy="18" r="11" />
            <circle class="fill" cx="443" cy="15" r="11" />
          </g>
        </g>
        </g>
        <g class="about-stage" data-left="451" data-right="595">
        <g class="grow grow--tree" style="animation-delay: 2.35s">
          <path class="fill" d="M512 93 C 516 78, 514 58, 516 44 L 530 44 C 532 58, 530 78, 536 93 Z" />
          <!-- Branches sit inside the swaying canopy, so the two move together
               and the branch tips do not peek in and out at its edges. -->
          <g class="sway sway--canopy" style="animation-delay: 3.50s">
            <path class="stroke" d="M520 56 L494 40 M526 54 L556 38 M522 48 L510 32" stroke-width="3.2" />
            <ellipse class="fill" cx="522" cy="28" rx="40" ry="17" />
            <ellipse class="fill" cx="478" cy="36" rx="26" ry="13" />
            <ellipse class="fill" cx="568" cy="34" rx="27" ry="13" />
            <circle class="fill" cx="500" cy="20" r="13" />
            <circle class="fill" cx="545" cy="18" r="14" />
            <circle class="fill" cx="522" cy="12" r="11" />
          </g>
          <g class="stroke roots" stroke-width="1.6">
            <path class="root" d="M466 46 C 465 62, 467 76, 466 90" style="animation-delay: 3.50s" />
            <path class="root" d="M484 47 C 485 60, 483 70, 484 80" style="animation-delay: 4.10s" />
            <path class="root" d="M560 46 C 561 60, 559 72, 560 86" style="animation-delay: 4.70s" />
            <path class="root" d="M578 45 C 577 58, 579 68, 578 76" style="animation-delay: 5.30s" />
          </g>
          <g transform="translate(498 8) scale(0.6 0.6)">
            <g class="bird-land" style="animation-delay: 3.6s">
            <g class="bird-bob" style="animation-delay: 5.50s; animation-duration: 3.4s">
            <g class="bird fill" style="animation-delay: 7.60s">
              <path class="wing" d="M-2 -15 C 2 -32, 12 -34, 15 -30 C 9 -24, 4 -18, -2 -15 Z" style="animation-delay: 3.6s" />
              <ellipse cx="0" cy="-11" rx="11" ry="9" />
              <circle cx="9" cy="-19" r="6.5" />
              <path d="M14.5 -21 L21 -18.5 L14.5 -16 Z" />
              <path d="M-8 -14 L-20 -21 L-17 -9 Z" />
              <rect x="-3" y="-3" width="1.6" height="4" />
              <rect x="2" y="-3" width="1.6" height="4" />
            </g>
            </g>
            </g>
          </g>
          <g transform="translate(530 2) scale(-0.55 0.55)">
            <g class="bird-land" style="animation-delay: 4.0s">
            <g class="bird-bob" style="animation-delay: 5.90s; animation-duration: 3.9s">
            <g class="bird fill" style="animation-delay: 8.00s">
              <path class="wing" d="M-2 -15 C 2 -32, 12 -34, 15 -30 C 9 -24, 4 -18, -2 -15 Z" style="animation-delay: 4.0s" />
              <ellipse cx="0" cy="-11" rx="11" ry="9" />
              <circle cx="9" cy="-19" r="6.5" />
              <path d="M14.5 -21 L21 -18.5 L14.5 -16 Z" />
              <path d="M-8 -14 L-20 -21 L-17 -9 Z" />
              <rect x="-3" y="-3" width="1.6" height="4" />
              <rect x="2" y="-3" width="1.6" height="4" />
            </g>
            </g>
            </g>
          </g>
          <g transform="translate(556 6) scale(0.6 0.6)">
            <g class="bird-land" style="animation-delay: 4.4s">
            <g class="bird-bob" style="animation-delay: 6.30s; animation-duration: 3.6s">
            <g class="bird fill" style="animation-delay: 8.40s">
              <path class="wing" d="M-2 -15 C 2 -32, 12 -34, 15 -30 C 9 -24, 4 -18, -2 -15 Z" style="animation-delay: 4.4s" />
              <ellipse cx="0" cy="-11" rx="11" ry="9" />
              <circle cx="9" cy="-19" r="6.5" />
              <path d="M14.5 -21 L21 -18.5 L14.5 -16 Z" />
              <path d="M-8 -14 L-20 -21 L-17 -9 Z" />
              <rect x="-3" y="-3" width="1.6" height="4" />
              <rect x="2" y="-3" width="1.6" height="4" />
            </g>
            </g>
            </g>
          </g>
        </g>
        </g>
      </svg>
    )}
    {variant === 'fees' && (
      <svg viewBox="0 0 224 100" preserveAspectRatio="xMaxYMax meet">
        <g class="stroke" stroke-width="2" stroke-linejoin="round">
          <path d="M40 90 L130 82 L130 22 L40 30 Z" />
          <path d="M130 82 L220 90 L220 30 L130 22 Z" />
        </g>
        <path class="stroke" d="M38 93 L130 85 L222 93" stroke-width="1.4" opacity="0.6" />
        <path class="stroke ink ink--0" d="M52.0 45.0 L55.0 46.1 L58.0 43.1 L61.0 44.2 L64.0 45.3 L67.0 42.3 L70.0 43.4 L73.0 44.5 L76.0 41.4 L79.0 42.5 L82.0 43.7 L85.0 40.6 L88.0 41.7 L91.0 42.8 L94.0 39.8 L97.0 40.9 L100.0 42.0 L103.0 39.0 L106.0 40.1 L109.0 41.2 L112.0 38.2 L115.0 39.3 L118.0 40.4" pathLength="1" stroke-width="1.8" />
        <path class="stroke ink ink--1" d="M52.0 57.0 L55.0 58.1 L58.0 55.0 L61.0 56.1 L64.0 57.2 L67.0 54.1 L70.0 55.2 L73.0 56.3 L76.0 53.2 L79.0 54.3 L82.0 55.4 L85.0 52.3 L88.0 53.4 L91.0 54.5 L94.0 51.4 L97.0 52.5 L100.0 53.6 L103.0 50.5 L106.0 51.6 L109.0 52.7 L112.0 49.6" pathLength="1" stroke-width="1.8" />
        <path class="stroke ink ink--2" d="M142.0 37.0 L145.0 38.7 L148.0 36.2 L151.0 37.8 L154.0 39.5 L157.0 37.0 L160.0 38.6 L163.0 40.3 L166.0 37.8 L169.0 39.5 L172.0 41.1 L175.0 38.6 L178.0 40.3 L181.0 41.9 L184.0 39.4 L187.0 41.1 L190.0 42.7 L193.0 40.3 L196.0 41.9 L199.0 43.6 L202.0 41.1 L205.0 42.7 L208.0 44.4" pathLength="1" stroke-width="1.8" />
        <path class="stroke ink ink--3" d="M142.0 49.0 L145.0 50.7 L148.0 48.2 L151.0 49.9 L154.0 51.5 L157.0 49.0 L160.0 50.7 L163.0 52.4 L166.0 49.9 L169.0 51.6 L172.0 53.2 L175.0 50.8 L178.0 52.4 L181.0 54.1 L184.0 51.6" pathLength="1" stroke-width="1.8" />
        <path class="stroke ink ink--4" d="M150 66 L156 72 L172 58" pathLength="1" stroke-width="2.6" stroke-linejoin="round" />
        <g class="pencil">
          <g class="fill">
            <path d="M0 0 L3 -9 L9 -3 Z" />
            <path d="M5 -11 L33 -39 L39 -33 L11 -5 Z" />
            <path d="M35 -41 L40 -46 L46 -40 L41 -35 Z" opacity="0.6" />
          </g>
        </g>
      </svg>
    )}
