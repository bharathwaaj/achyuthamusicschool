---
/**
 * Small animated drawings that sit along the bottom of a page hero.
 * Each piece moves on its own, slowly, using only transform and opacity
 * so the motion stays smooth. Motion stops for visitors who prefer
 * reduced motion. Use with the hero-surface--art class on the section,
 * which turns off the default string lines.
 */
interface Props {
  variant: 'veena' | 'violin' | 'vocal' | 'team';
}

const { variant } = Astro.props;

// Note and leaf shapes shared by the vocal and violin drawings.
const notes = (positions: [number, number][]) => positions;
---

<div class="hero-art" data-variant={variant} aria-hidden="true">
  <div class="hero-art__frame">
    {variant === 'vocal' && (
      <svg viewBox="0 0 600 100" preserveAspectRatio="xMinYMax meet">
        <g class="fill">
          <path d="M40 58 L112 58 L105 90 Q76 97 47 90 Z" />
          <ellipse cx="76" cy="95" rx="52" ry="3.5" />
        </g>
        <path class="stroke" d="M112 64 C 132 64, 132 84, 107 86" stroke-width="3" />
        <path class="stroke steam" d="M62 50 C 52 40, 72 32, 62 22 C 55 15, 66 8, 63 3" stroke-width="2.2" />
        <path class="stroke steam steam--late" d="M88 50 C 98 40, 78 33, 92 24 C 104 16, 118 18, 128 24" stroke-width="2.2" />
        {notes([[160, 40], [235, 30], [310, 44], [390, 32], [470, 42]]).map(([x, y], i) => (
          <g transform={`translate(${x} ${y})`}>
            <g class="note" style={`animation-delay: ${i * 1.4}s`}>
              <ellipse class="fill" cx="0" cy="0" rx="6.5" ry="4.6" transform="rotate(-20)" />
              <rect class="fill" x="4.6" y="-24" width="2" height="24" />
              <path class="stroke" d="M5.6 -24 C 13 -20, 15 -13, 11 -7" stroke-width="2" />
            </g>
          </g>
        ))}
      </svg>
    )}

    {variant === 'violin' && (
      <svg viewBox="0 0 600 100" preserveAspectRatio="xMinYMax meet">
        <path
          class="stroke"
          d="M10 34 C 120 34, 160 84, 280 74 S 460 44, 580 64"
          stroke-width="1.5"
          stroke-dasharray="1 9"
          opacity="0.6"
        />
        {[[30, 44, -35], [92, 64, 20], [152, 52, -60]].map(([x, y, r], i) => (
          <g transform={`translate(${x} ${y}) rotate(${r})`}>
            <g class="leaf" style={`animation-delay: ${-i * 1.7}s`}>
              <path class="fill" d="M0 -13 C 9 -8, 9 7, 0 13 C -9 7, -9 -8, 0 -13 Z" />
              <path class="stroke" d="M0 13 L0 19" stroke-width="2" />
            </g>
          </g>
        ))}
        {notes([[230, 74], [305, 62], [385, 58], [465, 48], [545, 58]]).map(([x, y], i) => (
          <g transform={`translate(${x} ${y})`}>
            <g class="note" style={`animation-delay: ${i * 1.4}s`}>
              {i < 2 ? (
                <path class="fill" d="M-1 -6 C 6 -6, 9 2, 2 5 C -5 8, -9 0, -1 -6 Z" transform="rotate(-25)" />
              ) : (
                <ellipse class="fill" cx="0" cy="0" rx="6.5" ry="4.6" transform="rotate(-20)" />
              )}
              <rect class="fill" x="4.6" y="-24" width="2" height="24" />
              <path class="stroke" d="M5.6 -24 C 13 -20, 15 -13, 11 -7" stroke-width="2" />
            </g>
          </g>
        ))}
      </svg>
    )}

    {variant === 'veena' && (
      <svg viewBox="0 0 1200 100" preserveAspectRatio="xMidYMax meet">
        <g class="stroke" stroke-width="1.5">
          <path d="M-2000 90 C -1500 84, -1000 96, -500 90 S 0 84, 300 90 S 900 96, 1200 90 S 2700 84, 3200 90" />
          <path d="M-2000 97 C -1500 93, -1000 101, -500 97 S 0 93, 320 97 S 960 101, 1200 97 S 2700 93, 3200 97" opacity="0.6" />
        </g>
        {[[140, 1], [620, 0.72], [1050, 0.88]].map(([x, s], i) => (
          <g transform={`translate(${x} 0) scale(${s}) translate(-80 0)`}>
            <g class="lotus fill" style={`animation-delay: ${-i * 2}s`}>
              <path d="M80 18 C 69 38, 69 58, 80 72 C 91 58, 91 38, 80 18 Z" />
              <path d="M80 72 C 60 66, 47 48, 45 32 C 60 38, 74 54, 80 72 Z" />
              <path d="M80 72 C 100 66, 113 48, 115 32 C 100 38, 86 54, 80 72 Z" />
              <path d="M80 75 C 55 77, 35 67, 24 54 C 44 53, 64 62, 80 75 Z" />
              <path d="M80 75 C 105 77, 125 67, 136 54 C 116 53, 96 62, 80 75 Z" />
              <ellipse cx="80" cy="82" rx="46" ry="4" />
            </g>
          </g>
        ))}
      </svg>
    )}

    {variant === 'team' && (
      <svg viewBox="0 0 1200 100" preserveAspectRatio="xMaxYMax meet">
        <g class="stroke" stroke-width="1.5">
          <path d="M-3000 55 L4200 55" />
          <path d="M-3000 88 L4200 88" opacity="0.7" />
        </g>
        {[
          [150, 55, false, 1], [195, 55, true, 0.85], [420, 88, false, 1], [610, 55, true, 1],
          [660, 55, false, 0.8], [880, 88, true, 1.1], [1080, 55, false, 1],
        ].map(([x, y, flip, s], i) => (
          <g transform={`translate(${x} ${y}) scale(${flip ? -s : s} ${s})`}>
            <g class="bird-land" style={`animation-delay: ${0.3 + i * 0.35}s`}>
            <g class="bird-bob" style={`animation-delay: ${2.2 + i * 0.35}s; animation-duration: ${3.2 + (i % 3) * 0.6}s`}>
            <g class="bird fill" style={`animation-delay: ${6 + i * 1.9}s`}>
              <path class="wing" d="M-2 -15 C 2 -32, 12 -34, 15 -30 C 9 -24, 4 -18, -2 -15 Z" style={`animation-delay: ${0.3 + i * 0.35}s`} />
              <ellipse cx="0" cy="-11" rx="11" ry="9" />
              <circle cx="9" cy="-19" r="6.5" />
              <path d="M14.5 -21 L21 -18.5 L14.5 -16 Z" />
              <path d="M-8 -14 L-20 -21 L-17 -9 Z" />
              <rect x="-3" y="-3" width="1.6" height="4" />
              <rect x="2" y="-3" width="1.6" height="4" />
            </g>
            </g>
            </g>
          </g>
        ))}
      </svg>
    )}
  </div>
</div>

<style>
  .hero-art {
    position: absolute;
    inset: auto 0 0 0;
    z-index: -1;
    pointer-events: none;
    color: var(--c-brand);
    opacity: 0.32;
  }

  /* Lines up with the page content, like the Container component. */
  .hero-art__frame {
    margin-inline: auto;
    max-width: 72rem;
    padding-inline: 1rem;
  }

  @media (min-width: 640px) {
    .hero-art__frame {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-art__frame {
      padding-inline: 2rem;
    }
  }

  svg {
    display: block;
    width: 100%;
    height: 3.5rem;
    overflow: visible;
  }

  @media (min-width: 768px) {
    svg {
      height: 4.5rem;
    }
  }

  .fill {
    fill: currentColor;
  }

  /* Wings only show while a bird is flying in. */
  .wing {
    opacity: 0;
  }

  .stroke {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
  }

  .note,
  .leaf,
  .lotus,
  .bird,
  .bird-bob,
  .bird-land,
  .steam {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Notes appear one after another, rise a little and fade away. */
    .note {
      opacity: 0;
      animation: note-rise 7s ease-in-out infinite;
    }

    /* Steam curls upward and fades, two wisps out of step. */
    .steam {
      animation: steam-rise 4.5s ease-in-out infinite;
    }

    .steam--late {
      animation-delay: 2.25s;
    }

    /* Leaves sway as they drift. */
    .leaf {
      animation: leaf-sway 6s ease-in-out infinite alternate;
    }

    /* Lotuses float on the water. */
    .lotus {
      animation: lotus-float 8s ease-in-out infinite alternate;
    }

    /* On first view each bird flies in from the upper right, flapping,
       and settles on the string. This plays once. */
    .bird-land {
      animation: bird-land 1.8s cubic-bezier(0.22, 0.8, 0.3, 1) both;
    }

    .wing {
      transform-box: fill-box;
      transform-origin: 0% 100%;
      animation: wing-flap 1.8s linear both;
    }

    /* Then they breathe and sway softly on the string, each at its own
       pace, and now and then tilt their heads. */
    .bird-bob {
      transform-origin: 50% 100%;
      animation: bird-bob 3.5s ease-in-out infinite alternate;
    }

    .bird {
      transform-origin: 50% 100%;
      animation: bird-tilt 13s ease-in-out infinite;
    }
  }

  @keyframes note-rise {
    0% {
      opacity: 0;
      transform: translate(-8px, 6px);
    }
    20% {
      opacity: 1;
    }
    70% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: translate(10px, -12px);
    }
  }

  @keyframes steam-rise {
    0% {
      opacity: 0;
      transform: translateY(5px);
    }
    40% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(-7px);
    }
  }

  @keyframes leaf-sway {
    from {
      transform: rotate(-10deg) translateY(-2px);
    }
    to {
      transform: rotate(10deg) translateY(2px);
    }
  }

  @keyframes lotus-float {
    from {
      transform: translateY(0) rotate(-1.5deg);
    }
    to {
      transform: translateY(-3px) rotate(1.5deg);
    }
  }

  @keyframes bird-land {
    0% {
      opacity: 0;
      transform: translate(90px, -70px) rotate(-12deg);
    }
    15% {
      opacity: 1;
    }
    70% {
      transform: translate(-3px, 2px) rotate(4deg);
    }
    85% {
      transform: translate(1px, -2px) rotate(-1deg);
    }
    100% {
      opacity: 1;
      transform: translate(0, 0) rotate(0deg);
    }
  }

  @keyframes wing-flap {
    0% {
      opacity: 1;
      transform: scaleY(1);
    }
    8% {
      opacity: 1;
      transform: scaleY(-0.5);
    }
    16% {
      opacity: 1;
      transform: scaleY(1);
    }
    24% {
      opacity: 1;
      transform: scaleY(-0.5);
    }
    32% {
      opacity: 1;
      transform: scaleY(1);
    }
    40% {
      opacity: 1;
      transform: scaleY(-0.5);
    }
    48% {
      opacity: 1;
      transform: scaleY(1);
    }
    56% {
      opacity: 1;
      transform: scaleY(-0.5);
    }
    64% {
      opacity: 1;
      transform: scaleY(1);
    }
    72% {
      opacity: 1;
      transform: scaleY(-0.5);
    }
    80% {
      opacity: 1;
      transform: scaleY(1);
    }
    92%,
    100% {
      opacity: 0;
      transform: scaleY(0.2);
    }
  }

  @keyframes bird-bob {
    from {
      transform: translateY(0) rotate(-2deg) scaleY(1);
    }
    to {
      transform: translateY(-1.5px) rotate(2deg) scaleY(1.04);
    }
  }

  @keyframes bird-tilt {
    0%,
    86%,
    100% {
      transform: rotate(0deg);
    }
    90% {
      transform: rotate(-8deg);
    }
    94% {
      transform: rotate(4deg);
    }
  }
</style>
