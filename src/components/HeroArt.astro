<script>
  // Fit the contact drawing to the content width. The box keeps a fixed
  // height, so its width in drawing units changes with the screen. The
  // path is stretched horizontally to that width, the house is moved to
  // the right end, and the plane follows the new path. The plane and
  // house keep their shape because only path points move.
  function fitContactArt(svg: SVGSVGElement) {
    const base = svg.dataset.basePath ?? '';
    const box = svg.getBoundingClientRect();
    if (!base || box.height === 0) return;
    const width = (box.width / box.height) * 100;
    const houseRight = 1162;
    const pathEnd = 1048;
    const scale = (width - (houseRight - pathEnd)) / pathEnd;
    let index = 0;
    // Path numbers alternate x, y; scale only the x values.
    const path = base.replace(/-?\d+(\.\d+)?/g, (n) => {
      const value = index % 2 === 0 ? Number(n) * scale : Number(n);
      index += 1;
      return value.toFixed(1);
    });
    svg.setAttribute('viewBox', `0 0 ${width.toFixed(1)} 100`);
    // The trail's last stretch moves with the house rather than stretching.
    const trail = svg.querySelector<SVGPathElement>('.contact-trail');
    const shift = width - houseRight;
    let tailIndex = 0;
    const tail = (trail?.dataset.tail ?? '').replace(/-?\d+(\.\d+)?/g, (n) => {
      const value = tailIndex % 2 === 0 ? Number(n) + shift : Number(n);
      tailIndex += 1;
      return value.toFixed(1);
    });
    trail?.setAttribute('d', `${path} ${tail}`);
    svg.querySelector('.contact-house')?.setAttribute('transform', `translate(${(width - houseRight).toFixed(1)} 0)`);
    const plane = svg.querySelector<SVGGElement>('.plane');
    if (plane) plane.style.offsetPath = `path('${path}')`;
  }

  // Spread the about drawing's seven stages across the content width, so
  // the seed sits at the left edge and the banyan's canopy ends at the
  // right edge. Each stage keeps its shape; only its position changes.
  function fitAboutArt(svg: SVGSVGElement) {
    const box = svg.getBoundingClientRect();
    if (box.height === 0) return;
    const width = (box.width / box.height) * 100;
    svg.setAttribute('viewBox', `0 0 ${width.toFixed(1)} 100`);
    svg.querySelector('.about-ground')?.setAttribute('d', `M0 93 L${width.toFixed(1)} 93`);
    // On narrow screens there is no room for every stage, so the grown
    // tree before the banyan is left out.
    const narrow = box.width < 640;
    svg.querySelectorAll<SVGGElement>('.about-stage--optional').forEach((stage) => {
      stage.style.display = narrow ? 'none' : '';
    });
    const stages = [...svg.querySelectorAll<SVGGElement>('.about-stage')].filter(
      (stage) => stage.style.display !== 'none',
    );
    // Lay the stages out edge to edge with equal gaps between them, from
    // the left edge to the right edge. Each stage's drawn extent is
    // stored on it, since its size changes while it grows in.
    const extents = stages.map((stage) => ({
      left: Number(stage.dataset.left ?? 0),
      right: Number(stage.dataset.right ?? 0),
    }));
    const total = extents.reduce((sum, e) => sum + (e.right - e.left), 0);
    const gap = (width - total) / (stages.length - 1);
    let cursor = 0;
    stages.forEach((stage, index) => {
      const { left, right } = extents[index];
      stage.setAttribute('transform', `translate(${(cursor - left).toFixed(1)} 0)`);
      cursor += right - left + gap;
    });
  }

  document.querySelectorAll<SVGSVGElement>('.about-art').forEach((svg) => {
    fitAboutArt(svg);
    new ResizeObserver(() => fitAboutArt(svg)).observe(svg);
  });

  document.querySelectorAll<SVGSVGElement>('.contact-art').forEach((svg) => {
    fitContactArt(svg);
    new ResizeObserver(() => fitContactArt(svg)).observe(svg);
  });
</script>

<style>
  .hero-art {
    position: absolute;
    inset: auto 0 0 0;
    z-index: -1;
    pointer-events: none;
    color: var(--c-brand);
    opacity: 0.32;
  }

  /* The contact drawing is mostly a thin trail, so it can be a little
     stronger and stay subtle. */
  .hero-art--contact {
    opacity: 0.45;
  }

  /* Lines up with the page content, like the Container component. */
  .hero-art__frame {
    margin-inline: auto;
    max-width: 72rem;
    padding-inline: 1rem;
  }

  @media (min-width: 640px) {
    .hero-art__frame {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-art__frame {
      padding-inline: 2rem;
    }
  }

  svg {
    display: block;
    width: 100%;
    height: 3.5rem;
    overflow: visible;
  }

  @media (min-width: 768px) {
    svg {
      height: 4.5rem;
    }
  }

  .fill {
    fill: currentColor;
  }

  /* House door and window show as openings in the house shape. */
  .door,
  .window {
    fill: var(--c-brand-soft);
  }

  /* With motion off, the plane rests partway along its path. */
  /* The plane is drawn with its tail at the path point, so at the start
     its back edge lines up with the page content above. */
  .plane {
    offset-distance: 45%;
    offset-rotate: auto;
  }

  /* Strings rest straight; their wavy shape only shows while they
     vibrate. Notes only show when a string is plucked. */
  .string {
    transform-box: fill-box;
    transform-origin: center;
    transform: scaleY(0.04);
  }

  .pluck-note {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Ink shows fully written, and the pencil rests by the tick, when
     motion is off. */
  .ink {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 0;
  }

  .pencil {
    transform: translate(172px, 58px);
  }

  /* Wings only show while a bird is flying in. */
  .wing {
    opacity: 0;
  }

  .stroke {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
  }

  .note,
  .leaf,
  .lotus,
  .bird,
  .bird-bob,
  .bird-land,
  .steam {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Plants grow up from, and sway on, the ground. */
  .grow,
  .sway,
  .root {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  .root {
    transform-origin: 50% 0%;
  }

  /* Frames swing from their peg at the top. */
  .frame-hang,
  .frame-swing {
    transform-box: fill-box;
    transform-origin: 50% 0%;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Notes appear one after another, rise a little and fade away. */
    .note {
      opacity: 0;
      animation: note-rise 7s ease-in-out infinite;
    }

    /* Steam curls upward and fades, two wisps out of step. */
    .steam {
      animation: steam-rise 4.5s ease-in-out infinite;
    }

    .steam--late {
      animation-delay: 2.25s;
    }

    /* Leaves sway as they drift. */
    .leaf {
      animation: leaf-sway 6s ease-in-out infinite alternate;
    }

    /* Lotuses float on the water. */
    .lotus {
      animation: lotus-float 8s ease-in-out infinite alternate;
    }

    /* A paper plane glides along the dotted path at a speed that changes
       smoothly: it loses speed as it climbs, gains it on the swoop down,
       and eases into the house, where the window lights up. The keyframes
       sample one continuous speed curve, so it never stops mid-flight. */
    .plane {
      animation: plane-fly 11s linear infinite;
    }

    .window {
      animation: window-glow 11s ease-in-out infinite;
    }


    .smoke {
      transform-box: fill-box;
      transform-origin: center;
      animation: steam-rise 5s ease-in-out infinite;
    }

    .smoke--late {
      animation-delay: 2.5s;
    }

    /* On first view the story grows from left to right: a seed, a
       sprout, a plant, a sapling, a young tree, a grown tree and a
       banyan, and then a few birds fly in to settle on the banyan. This
       plays once. Each plant starts to sway, and the banyan's roots to
       drift, only after it has finished growing, so the two motions
       never overlap. */
    .grow {
      animation: grow-up 1.1s cubic-bezier(0.3, 1.3, 0.5, 1) both;
    }

    .sway {
      animation: plant-sway 9s ease-in-out infinite;
    }

    .sway--canopy {
      animation-duration: 12s;
    }

    .root {
      animation: root-drift 11s ease-in-out infinite;
    }

    /* A pencil writes a few lines in the notebook and ticks the page,
       lifts away, and the writing fades before it starts again. The
       pencil and each line share one 10-second clock so they stay in
       step. */
    .pencil {
      animation: pencil-write 10s linear infinite;
    }

    .ink--0 {
      animation: ink-0 10s linear infinite;
    }

    .ink--1 {
      animation: ink-1 10s linear infinite;
    }

    .ink--2 {
      animation: ink-2 10s linear infinite;
    }

    .ink--3 {
      animation: ink-3 10s linear infinite;
    }

    .ink--4 {
      animation: ink-4 10s linear infinite;
    }

    /* The three strings are plucked one after another: each vibrates,
       settles, and sends a note floating up. One 9-second cycle. */
    .string--0,
    .pluck-note--0 {
      animation-duration: 9s;
      animation-iteration-count: infinite;
      animation-delay: 0.6s;
    }

    .string--0 {
      animation-name: string-pluck;
      animation-timing-function: linear;
    }

    .pluck-note--0 {
      animation-name: note-pop;
      animation-timing-function: ease-out;
    }

    .string--1,
    .pluck-note--1 {
      animation-duration: 9s;
      animation-iteration-count: infinite;
      animation-delay: 3.6s;
    }

    .string--1 {
      animation-name: string-pluck;
      animation-timing-function: linear;
    }

    .pluck-note--1 {
      animation-name: note-pop;
      animation-timing-function: ease-out;
    }

    .string--2,
    .pluck-note--2 {
      animation-duration: 9s;
      animation-iteration-count: infinite;
      animation-delay: 6.6s;
    }

    .string--2 {
      animation-name: string-pluck;
      animation-timing-function: linear;
    }

    .pluck-note--2 {
      animation-name: note-pop;
      animation-timing-function: ease-out;
    }

    /* On first view each frame drops onto the string and swings to a
       stop, one after another. Then they sway gently in the breeze. */
    .frame-hang {
      animation: frame-hang 2.2s cubic-bezier(0.25, 0.9, 0.3, 1) both;
    }

    .frame-swing {
      animation: frame-swing 4.5s ease-in-out infinite alternate;
    }

    /* On first view each bird flies in from the upper right, flapping,
       and settles on the string. This plays once. */
    .bird-land {
      animation: bird-land 1.8s cubic-bezier(0.22, 0.8, 0.3, 1) both;
    }

    .wing {
      transform-box: fill-box;
      transform-origin: 0% 100%;
      animation: wing-flap 1.8s linear both;
    }

    /* Then they breathe and sway softly on the string, each at its own
       pace, and now and then tilt their heads. */
    .bird-bob {
      transform-origin: 50% 100%;
      animation: bird-bob 3.5s ease-in-out infinite alternate;
    }

    .bird {
      transform-origin: 50% 100%;
      animation: bird-tilt 13s ease-in-out infinite;
    }
  }

