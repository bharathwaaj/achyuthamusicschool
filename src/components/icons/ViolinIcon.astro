---
import raw from '../../assets/icons/violin.svg?raw';

interface Props {
  size?: number | string;
  class?: string;
}

const { size = 24, class: className = '' } = Astro.props;

// Outline drawing in a single colour. Size it and let it take the
// surrounding text colour, so it works in light and dark.
const svg = raw
  .trim()
  .replace('<svg ', `<svg width="${size}" height="${size}" aria-hidden="true" class="${className}" `);
---

<Fragment set:html={svg} />
