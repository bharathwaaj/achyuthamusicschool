---
/**
 * Veena icon, drawn to match Lucide: 24x24 grid, outline strokes with
 * round ends, no fill, colour from currentColor. Lucide has no veena.
 *
 * Drawn upright and then tilted 45 degrees. What makes it read as a
 * veena: a large round resonator, a wide fretted neck that looks like a
 * ladder, a second small gourd on the neck, and tuning pegs at the head.
 */
interface Props {
  size?: number | string;
  strokeWidth?: number | string;
  class?: string;
}

const { size = 24, strokeWidth = 1.6, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <g transform="translate(1.2 -1.2) rotate(45 12 12)">
    <!-- resonator -->
    <circle cx="12" cy="22" r="4.3" />
    <!-- neck, two rails with frets between them -->
    <path d="M10.2 18.1V.6M13.8 18.1V.6" />
    <path d="M10.2 5h3.6M10.2 8h3.6M10.2 11h3.6M10.2 14h3.6" />
    <!-- head and pegs -->
    <path d="M10.2 .6c0-1.7 3.6-1.7 3.6 0" />
    <path d="M10.2 2.4H8.6M10.2 4.6H8.6" />
    <!-- second gourd -->
    <circle cx="16" cy="9" r="2.1" />
  </g>
</svg>
