---
import { Image } from 'astro:assets';
import { ExternalLink, Mail, MapPin, MessageCircle, Phone } from '@lucide/astro';
import studentsPhoto from '../assets/gallery/veena-group-class.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Faq from '../components/Faq.astro';
import HeroArt from '../components/HeroArt.astro';
import { site } from '../config/site';
import { breadcrumbSchema, faqSchema, pageSchema } from '../utils/schema';
import { whatsappLink, whatsappMessages } from '../utils/whatsapp';

const title = `Contact ${site.name}, ${site.area}, ${site.city}`;
const description = `Message us on WhatsApp about veena, violin or Carnatic vocal classes. You can also email, or visit our school in ${site.area}, ${site.city}.`;

const ways = [
  { icon: MessageCircle, label: 'WhatsApp', value: site.whatsappDisplay, href: whatsappLink(whatsappMessages.general), external: true },
  { icon: Mail, label: 'Email', value: site.email, href: `mailto:${site.email}`, external: false },
  { icon: Phone, label: 'Phone', value: site.phoneDisplay, href: `tel:${site.phone}`, external: false },
];

const faqs = [
  {
    question: 'Is there an age limit to learn music?',
    answer: 'No. What matters is your interest and dedication, so children and adults are both welcome.',
  },
  {
    question: 'Can I learn the instrument online?',
    answer: 'Yes. Online is how we prefer to teach, and it works well with patience and practice.',
  },
];

---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[
    pageSchema('ContactPage', title, '/contact/', description),
    faqSchema(faqs),
    breadcrumbSchema([{ name: 'Contact', path: '/contact/' }]),
  ]}
  image={studentsPhoto}
  imageAlt="A group of young veena students seated together with their instruments"
>
  <section class="hero-surface hero-surface--art border-b border-line py-14 md:py-20">
    <HeroArt variant="contact" />
    <Container size="wide" class="grid items-center gap-10 md:grid-cols-2">
      <div>
      <SectionHeading
        level={1}
        eyebrow="Contact"
        title="We would love to hear from you"
        lead="The quickest way to reach us is WhatsApp. Tell us who will be learning and we will take it from there."
      />
      <div class="mt-8">
        <Button href={whatsappLink(whatsappMessages.general)} external size="lg">
          <MessageCircle size={17} aria-hidden="true" /> Message us on WhatsApp
        </Button>
      </div>
      </div>
      <div class="overflow-hidden rounded-2xl border border-line" style="aspect-ratio: 4/3;">
        <Image
          src={studentsPhoto}
          alt="A group of young veena students seated together with their instruments"
          width={1200}
          sizes="(min-width: 1152px) 524px, (min-width: 1024px) calc(50vw - 52px), (min-width: 768px) calc(50vw - 44px), (min-width: 640px) calc(100vw - 48px), calc(100vw - 32px)"
          loading="eager"
          class="h-full w-full object-cover"
        />
      </div>
    </Container>
  </section>

  <section class="py-14 md:py-16">
    <Container size="wide" class="grid gap-5 lg:grid-cols-[2fr_3fr]">
      <div class="flex min-w-0 flex-col gap-5">
      <div class="rounded-2xl border border-line bg-surface p-6 md:p-8">
        <h2 class="text-xl font-semibold text-ink">Get in touch</h2>
        <ul class="mt-5 space-y-4">
          {ways.map((way) => (
            <li class="flex items-center gap-4">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-soft text-link">
                <way.icon size={20} aria-hidden="true" />
              </span>
              <span class="min-w-0">
                <span class="block text-sm text-muted">{way.label}</span>
                <a
                  href={way.href}
                  class="font-medium text-link [overflow-wrap:anywhere] hover:text-link-hover"
                  target={way.external ? '_blank' : undefined}
                  rel={way.external ? 'noopener noreferrer' : undefined}
                >
                  {way.value.includes('@') ? (
                    <Fragment>{way.value.split('@')[0]}@<wbr />{way.value.split('@')[1]}</Fragment>
                  ) : (
                    way.value
                  )}
                </a>
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl border border-line bg-surface p-6 md:p-8">
        <h2 class="text-xl font-semibold text-ink">Visit us</h2>
        <div class="mt-5 flex gap-4">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-soft text-link">
            <MapPin size={20} aria-hidden="true" />
          </span>
          <div>
            <p class="font-medium text-ink">{site.address}</p>
            <p class="mt-1 text-balance text-sm text-muted">{site.landmark}</p>
            <a
              href={site.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-link hover:text-link-hover"
            >
              Get directions <ExternalLink size={14} aria-hidden="true" />
            </a>
          </div>
        </div>
        <p class="mt-5 border-t border-line pt-5 leading-relaxed text-muted">
          Planning to visit our school in {site.area}? Message us first, so we can find a time that
          suits you.
        </p>
      </div>
      </div>

      <div class="relative min-h-[22rem] overflow-hidden rounded-2xl border border-line bg-sunken">
        <iframe
          src={site.mapsEmbedUrl}
          title="Map showing the location of Achyutha Music School"
          class="absolute inset-0 h-full w-full border-0"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
    </Container>
  </section>

  <section class="border-t border-line bg-sunken py-14 md:py-16">
    <Container size="narrow">
      <SectionHeading title="Quick answers" align="center" />
      <div class="mt-8"><Faq items={faqs} /></div>
    </Container>
  </section>
</BaseLayout>
