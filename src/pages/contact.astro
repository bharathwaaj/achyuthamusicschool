---
import { Mail, MapPin, MessageCircle, Phone } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Faq from '../components/Faq.astro';
import { site } from '../config/site';
import { canonicalUrl } from '../utils/seo';
import { whatsappLink, whatsappMessages } from '../utils/whatsapp';

const title = `Contact ${site.name}: WhatsApp, Email and Visits`;
const description = `Message ${site.name} on WhatsApp to ask about veena, violin or Carnatic vocal classes. You can also email us, or visit our school in ${site.area}, ${site.city}.`;

const faqs = [
  {
    question: 'Is there an age limit to learn music?',
    answer: 'No. What matters is your interest and dedication, so children and adults are both welcome.',
  },
  {
    question: 'Can I learn the instrument online?',
    answer: 'Yes. Online is how we prefer to teach, and it works well with patience and practice.',
  },
];

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: title,
  url: canonicalUrl('/contact/'),
  about: { '@type': 'EducationalOrganization', name: site.name, url: site.url },
};
---

<BaseLayout title={title} description={description} jsonLd={[contactSchema]}>
  <section class="border-b border-line bg-brand-soft py-14 md:py-20">
    <Container size="wide">
      <SectionHeading
        level={1}
        eyebrow="Contact"
        title="We would love to hear from you"
        lead="The quickest way to reach us is WhatsApp. Tell us who will be learning and we will take it from there."
      />
      <div class="mt-8">
        <Button href={whatsappLink(whatsappMessages.general)} external size="lg">
          <MessageCircle size={17} aria-hidden="true" /> Message us on WhatsApp
        </Button>
      </div>
    </Container>
  </section>

  <section class="py-14 md:py-16">
    <Container size="wide">
      <ul class="grid gap-5 md:grid-cols-3">
        <li class="rounded-2xl border border-line bg-surface p-6 text-center">
          <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand-soft text-link">
            <Mail size={26} aria-hidden="true" />
          </span>
          <h2 class="mt-4 text-lg font-semibold text-ink">Email</h2>
          <p class="mt-1 break-words">
            <a href={`mailto:${site.email}`} class="text-link hover:text-link-hover">{site.email}</a>
          </p>
        </li>
        <li class="rounded-2xl border border-line bg-surface p-6 text-center">
          <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand-soft text-link">
            <Phone size={26} aria-hidden="true" />
          </span>
          <h2 class="mt-4 text-lg font-semibold text-ink">Phone</h2>
          <p class="mt-1">
            <a href={`tel:${site.phone}`} class="text-link hover:text-link-hover">{site.phoneDisplay}</a>
          </p>
        </li>
        <li class="rounded-2xl border border-line bg-surface p-6 text-center">
          <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand-soft text-link">
            <MapPin size={26} aria-hidden="true" />
          </span>
          <h2 class="mt-4 text-lg font-semibold text-ink">Visit us</h2>
          <p class="mt-1 text-muted">{site.address}</p>
          <p class="text-sm text-subtle">{site.landmark}</p>
        </li>
      </ul>
      <p class="mx-auto mt-8 max-w-xl text-center leading-relaxed text-muted">
        Planning to visit our school in {site.area}? Message us first, so we can find a time that
        suits you.
      </p>
    </Container>
  </section>

  <section class="border-t border-line py-14 md:py-16">
    <Container size="wide">
      <SectionHeading title="Find our school" align="center" />
      <div
        id="school-map"
        class="relative mt-8 flex items-center justify-center overflow-hidden rounded-2xl border border-line bg-sunken"
        style="aspect-ratio: 16/9; min-height: 18rem;"
        data-src={site.mapsEmbedUrl}
      >
        <div class="px-6 text-center">
          <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand-soft text-link">
            <MapPin size={26} aria-hidden="true" />
          </span>
          <p class="mt-3 text-muted">{site.address}</p>
          <p class="text-sm text-subtle">{site.landmark}</p>
          <div class="mt-5 flex flex-wrap justify-center gap-3">
            <button
              type="button"
              data-show-map
              class="inline-flex cursor-pointer items-center justify-center whitespace-nowrap rounded-full border border-brand bg-brand px-5 py-2.5 text-sm font-semibold text-brand-on transition-colors hover:border-brand-strong hover:bg-brand-strong"
            >
              Show the map
            </button>
            <Button href={site.mapsUrl} external variant="secondary" size="md">Open in Google Maps</Button>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section class="border-t border-line bg-sunken py-14 md:py-16">
    <Container size="narrow">
      <SectionHeading title="Quick answers" align="center" />
      <div class="mt-8"><Faq items={faqs} /></div>
    </Container>
  </section>
</BaseLayout>

<script>
  // Load the Google map only when the visitor asks for it, so the page makes
  // no third-party requests until then.
  const box = document.getElementById('school-map');
  box?.querySelector('[data-show-map]')?.addEventListener('click', () => {
    const src = box.dataset.src;
    if (!src) return;
    const frame = document.createElement('iframe');
    frame.src = src;
    frame.title = 'Map showing the location of Achyutha Music School';
    frame.loading = 'lazy';
    frame.referrerPolicy = 'strict-origin-when-cross-origin';
    frame.className = 'absolute inset-0 h-full w-full border-0';
    box.replaceChildren(frame);
  });
</script>
