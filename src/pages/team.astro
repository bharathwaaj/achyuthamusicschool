---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaPanel from '../components/CtaPanel.astro';
import jayanthi from '../assets/images/jayanthi-ravichandran.jpg';
import divya from '../assets/images/dr-divya.jpg';
import { site } from '../config/site';

const title = 'Our Teachers: Veena, Violin and Carnatic Vocal';
const description =
  'Meet the teachers at Achyutha Music School: Jayanthi Ravichandran, who trained under Sri S.V. Achyutha Iyer, and Dr. Divya C.R., who teaches Carnatic vocal and violin.';

const teachers = [
  {
    name: 'Jayanthi Ravichandran',
    photo: jayanthi,
    tags: [] as string[],
    text: `Trained for about ten years under ${site.guru}, then continued with the veena artists Pudukkottai Krishnamurthy and Smt. Padma Krishnamurthy.`,
  },
  {
    name: 'Dr. Divya C.R.',
    photo: divya,
    tags: ['Carnatic vocal', 'Violin'],
    text: 'A performer and teacher with over twenty years of experience. She is also a psychiatrist, and she helps students build both technique and a deep feeling for the music.',
  },
];
---

<BaseLayout title={title} description={description}>
  <section class="border-b border-line bg-brand-soft py-14 md:py-20">
    <Container size="wide">
      <SectionHeading
        level={1}
        eyebrow="Our teachers"
        title="Meet your teachers"
        lead="The people who will guide your lessons, whether you join online or in person."
      />
    </Container>
  </section>

  <section class="py-14 md:py-20">
    <Container size="wide" class="space-y-14 md:space-y-20">
      {teachers.map((teacher, index) => (
        <article class="grid items-center gap-8 md:grid-cols-[2fr_3fr] md:gap-12">
          <div
            class:list={[
              'mx-auto w-full max-w-sm overflow-hidden rounded-2xl border border-line',
              index % 2 === 1 && 'md:order-2',
            ]}
            style="aspect-ratio: 4/5;"
          >
            <Image
              src={teacher.photo}
              alt={teacher.name}
              width={640}
              sizes="(min-width: 768px) 384px, 100vw"
              class="h-full w-full object-cover object-top"
            />
          </div>
          <div>
            <h2 class="text-3xl font-semibold text-ink">{teacher.name}</h2>
            {teacher.tags.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-2">
                {teacher.tags.map((tag) => (
                  <li class="rounded-full bg-brand-soft px-3 py-1 text-xs font-medium text-link">{tag}</li>
                ))}
              </ul>
            )}
            <p class="mt-4 text-lg leading-relaxed text-muted">{teacher.text}</p>
          </div>
        </article>
      ))}
    </Container>
  </section>

  <CtaPanel title="Learn with us" text="Tell us who will be learning and which class interests you. We will take it from there." />
</BaseLayout>
