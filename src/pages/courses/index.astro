---
import { ArrowRight, CalendarClock, Laptop, MapPin, Sprout } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import { courses } from '../../data/courses';

const title = 'Online Veena, Violin and Carnatic Vocal Classes';
const description =
  'Not sure which class to choose? See how veena, violin and Carnatic vocal classes differ, how online and in-person lessons work, and how to get started.';

// One line on who each class suits. Kept general: no syllabus facts.
const suits: Record<string, string> = {
  veena:
    'You want to learn the instrument at the heart of our school, or you are a parent looking for a calm, rewarding instrument for your child.',
  violin:
    'You like the idea of a melody instrument played in the Carnatic style, and weekend sessions will help you fit lessons in.',
  vocal:
    'You love to sing, or want to learn Carnatic music through your own voice. Weekend sessions are available.',
};

const howItWorks = [
  {
    icon: Laptop,
    title: 'Online, from anywhere',
    text: 'All three classes are taught online. This is how we prefer to teach, and students join from different cities.',
  },
  {
    icon: MapPin,
    title: 'In person, if you live nearby',
    text: 'You are also welcome at our school in Kovaipudur, Coimbatore. Tell us which you would like.',
  },
  {
    icon: CalendarClock,
    title: 'Weekends for violin and vocal',
    text: 'Violin and vocal have weekend sessions, which suit school and work weeks.',
  },
  {
    icon: Sprout,
    title: 'Beginners and beyond',
    text: 'Children and adults are welcome, whether you are starting fresh or returning to music.',
  },
];
---

<BaseLayout title={title} description={description}>
  <section class="border-b border-line bg-brand-soft py-14 md:py-20">
    <Container size="wide">
      <SectionHeading
        level={1}
        eyebrow="Our classes"
        title="Which class is right for you?"
        lead="We teach the veena, violin and Carnatic vocal. Here is a little about each, and how classes work, so you can choose with confidence."
      />
    </Container>
  </section>

  <section class="py-14 md:py-16">
    <Container size="narrow">
      <ul class="divide-y divide-line rounded-2xl border border-line bg-surface">
        {courses.map((course) => (
          <li class="p-6">
            <h2 class="text-xl font-semibold text-ink">
              {course.name}
              {course.primary && (
                <span class="ml-2 rounded-full bg-brand-soft px-2.5 py-0.5 align-middle text-xs font-medium text-link">
                  Our main class
                </span>
              )}
            </h2>
            <p class="mt-2 leading-relaxed text-muted">
              <span class="font-medium text-ink">A good fit if</span>
              {' '}{suits[course.slug].charAt(0).toLowerCase() + suits[course.slug].slice(1)}
            </p>
            <a
              href={course.href}
              class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-link hover:text-link-hover"
            >
              About {course.name.toLowerCase()} classes
              <ArrowRight size={16} aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <section class="border-y border-line bg-sunken py-14 md:py-16">
    <Container size="wide">
      <SectionHeading title="How classes work" />
      <ul class="mt-8 grid gap-5 md:grid-cols-2">
        {howItWorks.map((item) => (
          <li class="flex gap-4 rounded-2xl border border-line bg-surface p-6">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-soft text-link">
              <item.icon size={22} aria-hidden="true" />
            </span>
            <div>
              <h3 class="font-semibold text-ink">{item.title}</h3>
              <p class="mt-1 leading-relaxed text-muted">{item.text}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="mt-8 max-w-2xl leading-relaxed text-muted">
        Theory classes are held twice a month. They are optional and charged separately. Fees
        depend on the number of classes and the level, and we are happy to share the details
        when you message us.
      </p>
    </Container>
  </section>

  <section class="py-14 md:py-16">
    <Container size="narrow">
      <SectionHeading title="Not sure where to begin?" />
      <p class="mt-4 text-lg leading-relaxed text-muted">
        Tell us who will be learning, their age, and whether they have played before. We will
        suggest a class and a timing that suits you.
      </p>
    </Container>
  </section>

  <CtaPanel />
</BaseLayout>
