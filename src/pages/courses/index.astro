---
import { ArrowRight, CalendarClock, Laptop, MapPin, Sprout } from '@lucide/astro';
import { breadcrumbSchema } from '../../utils/schema';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import HeroArt from '../../components/HeroArt.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import instruments from '../../assets/images/instruments.png';
import veenaOnline from '../../assets/images/veena-online.png';
import violinPractice from '../../assets/images/violin-practice.png';
import vocalPractice from '../../assets/images/vocal-practice.png';
import { courses } from '../../data/courses';
import { objectBrief, photoBrief } from '../../data/imagePrompts';

const title = 'Veena, Violin and Vocal Classes Online';
const description =
  'Not sure which class to choose? See how veena, violin and Carnatic vocal classes differ, how online and in-person lessons work, and how to get started.';

// One short line per class. Kept general: no syllabus facts.
const suits: Record<string, string> = {
  veena: 'Learn the instrument at the heart of our school.',
  violin: 'Play the violin in the Carnatic style.',
  vocal: 'Learn Carnatic music through your own voice.',
};


// Briefs for photographs to be generated outside the site, one per slot.
const heroPrompt = objectBrief('A veena, a violin and a tambura resting against a plain wall in a living room.');
const classPrompts: Record<string, string> = {
  veena: photoBrief('An adult learner seated beside a veena at home, looking at a laptop that shows the teacher during an online lesson.'),
  violin: photoBrief('A teenage student practising the violin in the Carnatic style at home, seated on the floor.'),
  vocal: photoBrief('A young woman singing at home, a tambura beside her, one hand resting on her knee.'),
};

// Short descriptions of the photos, for screen readers and search engines.
const classAlts: Record<string, string> = {
  veena: 'An adult learner with a veena, following an online lesson on a laptop',
  violin: 'A student practising the violin, seated on the floor',
  vocal: 'A young woman singing at home with a tambura beside her',
};

const howItWorks = [
  { icon: Laptop, title: 'Online, from anywhere' },
  { icon: MapPin, title: 'In person in Kovaipudur' },
  { icon: CalendarClock, title: 'Weekends for violin and vocal' },
  { icon: Sprout, title: 'Children, adults, beginners' },
];
const classImages = { veena: veenaOnline, violin: violinPractice, vocal: vocalPractice };
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[breadcrumbSchema([{ name: 'Classes', path: '/courses/' }])]}
  image={instruments}
  imageAlt="A veena, a violin and a tambura resting against a wall"
>
  <section class="hero-surface hero-surface--art border-b border-line py-14 md:py-20">
    <HeroArt variant="courses" />
    <Container size="wide" class="grid items-center gap-10 md:grid-cols-2">
      <SectionHeading
        level={1}
        eyebrow="Our classes"
        title="Which class is right for you?"
        lead="We teach the veena, violin and Carnatic vocal. Here is a little about each, and how classes work, so you can choose with confidence."
      />
      <ImagePlaceholder prompt={heroPrompt} alt="A veena, a violin and a tambura resting against a wall" src={instruments} width={1200} height={900} aspect="4/3" loading="eager" />
    </Container>
  </section>

  <section class="py-14 md:py-16">
    <Container size="wide" class="space-y-14 md:space-y-20">
      {courses.map((course, index) => (
        <article class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
          <ImagePlaceholder
            prompt={classPrompts[course.slug]}
            alt={classAlts[course.slug]}
            src={classImages[course.slug]}
            width={1200}
            height={900}
            aspect="4/3"
            sizes="(min-width: 1152px) 520px, (min-width: 1024px) calc(50vw - 56px), (min-width: 768px) calc(50vw - 48px), (min-width: 640px) calc(100vw - 48px), calc(100vw - 32px)"
            class={index % 2 === 1 ? 'md:order-2' : ''}
          />
          <div>
            {course.primary && (
              <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-link">Our main class</p>
            )}
            <h2 class="text-3xl font-semibold text-ink">{course.name}</h2>
            <p class="mt-3 text-lg text-muted">{suits[course.slug]}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {course.formats.map((format) => (
                <li class="rounded-full bg-brand-soft px-3 py-1 text-xs font-medium text-link">{format}</li>
              ))}
            </ul>
            <a
              href={course.href}
              class="mt-5 inline-flex items-center gap-1 font-semibold text-link hover:text-link-hover"
            >
              About {course.name.toLowerCase()} classes
              <ArrowRight size={18} aria-hidden="true" />
            </a>
          </div>
        </article>
      ))}
    </Container>
  </section>

  <section class="border-y border-line bg-sunken py-14 md:py-16">
    <Container size="wide">
      <SectionHeading title="How classes work" align="center" />
      <ul class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4">
        {howItWorks.map((item) => (
          <li class="flex flex-col items-center gap-3 rounded-2xl border border-line bg-surface p-5 text-center">
            <span class="flex h-14 w-14 items-center justify-center rounded-full bg-brand-soft text-link">
              <item.icon size={26} aria-hidden="true" />
            </span>
            <span class="font-medium text-ink">{item.title}</span>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-center text-muted">
        Message us for fees and timings.
      </p>
    </Container>
  </section>

  <CtaPanel />
</BaseLayout>
