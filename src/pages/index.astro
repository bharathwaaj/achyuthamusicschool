---
import { MessageCircle } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CourseCard from '../components/CourseCard.astro';
import Faq from '../components/Faq.astro';
import { courses } from '../data/courses';
import { BookOpenText, CalendarClock, HeartHandshake } from '@lucide/astro';
import { site } from '../config/site';
import { whatsappLink, whatsappMessages } from '../utils/whatsapp';

const title = 'Online Carnatic Music Classes | Vocal, Violin and Veena in Coimbatore';
const description =
  'Learn Carnatic vocal, violin or veena online, or in person in Kovaipudur, Coimbatore. Personal lessons for children and adults in the tradition of Sri S.V. Achyutha Iyer.';

const whyPoints = [
  {
    icon: HeartHandshake,
    title: 'Lessons shaped around the student',
    text: 'Each student learns at their own pace. Children, adults, first-time learners and those returning to music all begin with a conversation about where they are.',
  },
  {
    icon: BookOpenText,
    title: 'Rooted in a guru\'s teaching',
    text: `The school is founded on the teachings of ${site.guru} and carries forward his care for the discipline and beauty of Carnatic music.`,
  },
  {
    icon: CalendarClock,
    title: 'Timings that suit family life',
    text: 'Veena classes are also available online, and vocal and violin have weekend sessions, so lessons can fit around school and work.',
  },
];

// The street address and opening hours are left out until the school
// confirms them. Do not invent values here.
const schoolSchema = {
  '@context': 'https://schema.org',
  '@type': ['EducationalOrganization', 'LocalBusiness'],
  '@id': `${site.url}/#school`,
  name: site.name,
  url: site.url,
  description,
  telephone: site.phone,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.area,
    addressRegion: site.state,
    addressCountry: site.country,
  },
  areaServed: site.city,
  knowsAbout: ['Carnatic vocal', 'Carnatic violin', 'Veena'],
};

const steps = [
  {
    title: 'Talk to the instructors',
    text: 'Tell us who will be learning, their age and any earlier experience. We will suggest where to begin.',
  },
  {
    title: 'Choose a class and timing',
    text: 'Pick vocal, violin or veena and settle on a schedule that works for your family.',
  },
  {
    title: 'Begin at your own pace',
    text: 'Lessons start from where the student is, and move on as they grow in confidence.',
  },
];

const faqs = [
  {
    question: 'Can a complete beginner join?',
    answer: 'Yes. The school teaches all ages and skill levels, and every student begins with a conversation with the instructors about where to start.',
  },
  {
    question: 'Are online classes available?',
    answer: 'Veena classes are available online. Vocal and violin have weekend sessions. Message us with your preferred instrument and timing, and we will tell you what is possible.',
  },
  {
    question: 'How much do the classes cost?',
    answer: 'Fees depend on how many classes a student needs and their level of learning. Theory classes, held twice a month, are optional and charged separately. Message us for the current details.',
  },
  {
    question: 'Where are the classes held?',
    answer: 'In Kovaipudur, Coimbatore. Message us on WhatsApp and we will share the exact location.',
  },
];
---

<BaseLayout title={title} description={description} jsonLd={[schoolSchema]}>
  <section class="border-b border-line bg-brand-soft">
    <Container size="wide" class="grid items-center gap-10 py-14 md:grid-cols-2 md:py-20">
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-link">
          Online and in {site.area}, {site.city}
        </p>
        <h1 class="text-4xl font-semibold leading-tight text-ink sm:text-5xl">
          Carnatic music classes, online and in Coimbatore
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
          Learn vocal, violin or veena in the tradition of {site.guru}. Online is how we
          prefer to teach, so students can learn from wherever they are. We also teach in
          person at our school in {site.area}, {site.city}.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={whatsappLink(whatsappMessages.general)} external size="lg">
            <MessageCircle size={18} aria-hidden="true" /> Message us on WhatsApp
          </Button>
          <Button href="/courses/" variant="secondary" size="lg">See the classes</Button>
        </div>
      </div>

      <ImagePlaceholder
        prompt="A teacher and a young student sitting together on a mat with a veena and a violin beside them, a brass lamp glowing, warm sandal-orange and charcoal palette on ivory, calm and respectful mood, illustrated editorial style, no text, no logos"
        width={1200}
        height={900}
        aspect="4/3"
        loading="eager"
      />
    </Container>
  </section>

  <section class="py-16 md:py-20">
    <Container size="wide">
      <SectionHeading
        title="Choose your instrument"
        lead="The school teaches three Carnatic disciplines. Pick the one that draws you, or message us and we will help you decide."
      />
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {courses.map((course) => <CourseCard course={course} />)}
      </div>
    </Container>
  </section>

  <section class="border-y border-line bg-sunken py-16 md:py-20">
    <Container size="wide">
      <SectionHeading
        title="Learning at Achyutha"
        lead="Carnatic music is learned slowly and in person, with a teacher who listens. The classes are set up to make that easy for families."
      />
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {whyPoints.map((point) => (
          <div>
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-soft text-link">
              <point.icon size={22} aria-hidden="true" />
            </span>
            <h3 class="mt-4 text-lg font-semibold text-ink">{point.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{point.text}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section class="py-16 md:py-20">
    <Container size="narrow">
      <SectionHeading
        eyebrow="Our guru"
        title={`In the tradition of ${site.guru}`}
        lead="The school grew from the teaching of Sri S.V. Achyutha Iyer, and its teachers include people who learned directly from him and from other respected artists."
      />
      <ul class="mt-8 space-y-5">
        <li class="rounded-2xl border border-line bg-surface p-6">
          <h3 class="text-lg font-semibold text-ink">Jayanthi Ravichandran</h3>
          <p class="mt-2 leading-relaxed text-muted">
            Trained for about ten years under {site.guru}, then continued with the veena artists
            Pudukkottai Krishnamurthy and Smt. Padma Krishnamurthy.
          </p>
        </li>
        <li class="rounded-2xl border border-line bg-surface p-6">
          <h3 class="text-lg font-semibold text-ink">Dr. Divya C.R.</h3>
          <p class="mt-2 leading-relaxed text-muted">
            A performer and teacher of Carnatic vocal and violin with over twenty years of
            experience.
          </p>
        </li>
      </ul>
      <p class="mt-8">
        <Button href="/team/" variant="ghost">Meet all our teachers</Button>
      </p>
    </Container>
  </section>

  <section class="border-y border-line bg-brand-soft py-16 md:py-20">
    <Container size="wide">
      <SectionHeading title="How to get started" align="center" />
      <ol class="mt-10 grid gap-6 md:grid-cols-3">
        {steps.map((step, index) => (
          <li class="rounded-2xl border border-line bg-surface p-6">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand font-semibold text-brand-on">
              {index + 1}
            </span>
            <h3 class="mt-4 text-lg font-semibold text-ink">{step.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{step.text}</p>
          </li>
        ))}
      </ol>
    </Container>
  </section>

  <section class="py-16 md:py-20">
    <Container size="narrow">
      <SectionHeading title="Questions parents often ask" />
      <div class="mt-8">
        <Faq items={faqs} />
      </div>
      <p class="mt-6 text-muted">
        More about costs is on our <a href="/fees-enrollment/">fees and enrolment page</a>.
      </p>
    </Container>
  </section>

  <section class="px-4 pb-4 sm:px-6">
    <Container size="wide" class="rounded-3xl bg-header px-6 py-12 text-center text-header-text md:py-16">
      <h2 class="text-3xl font-semibold sm:text-4xl">Ready to begin?</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed opacity-85">
        Send us a message and tell us who will be learning. We will help you choose the right
        class and timing.
      </p>
      <div class="mt-8 flex justify-center">
        <Button href={whatsappLink(whatsappMessages.general)} external size="lg">
          <MessageCircle size={18} aria-hidden="true" /> Message us on WhatsApp
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>
