---
import { Clock, Laptop, MessageCircle, Music2 } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CourseCard from '../components/CourseCard.astro';
import Faq from '../components/Faq.astro';
import { courses } from '../data/courses';
import { BookOpenText, CalendarClock, HeartHandshake } from '@lucide/astro';
import { site } from '../config/site';
import { whatsappLink, whatsappMessages } from '../utils/whatsapp';

const title = 'Online Veena Classes for Children and Adults';
const description =
  'Learn the classical veena online with personal lessons for children and adults, in the tradition of Sri S.V. Achyutha Iyer. Carnatic violin and vocal classes are also offered.';

const heroPoints = [
  { icon: Laptop, text: 'Online classes, from wherever you are' },
  { icon: Clock, text: 'A pace that feels right for you' },
  { icon: Music2, text: 'Violin and Carnatic vocal too' },
];

const whyPoints = [
  {
    icon: HeartHandshake,
    title: 'Lessons shaped around the student',
    text: 'Everyone learns at their own pace. Whether you are a child, an adult, a first-timer or coming back to music, we begin by talking about where you are now.',
  },
  {
    icon: BookOpenText,
    title: 'Rooted in a guru\'s teaching',
    text: `Our school grows from the teaching of ${site.guru}, a violinist. We try to keep alive his care for the discipline and beauty of Carnatic music.`,
  },
  {
    icon: CalendarClock,
    title: 'Learn from home, or in person',
    text: 'We prefer to teach online, so you can learn from home. You are also welcome at our school in Kovaipudur. Vocal and violin have weekend sessions for busy school and work weeks.',
  },
];

// The street address and opening hours are left out until the school
// confirms them. Do not invent values here.
const schoolSchema = {
  '@context': 'https://schema.org',
  '@type': ['EducationalOrganization', 'LocalBusiness'],
  '@id': `${site.url}/#school`,
  name: site.name,
  url: site.url,
  description,
  telephone: site.phone,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.area,
    addressRegion: site.state,
    addressCountry: site.country,
  },
  knowsAbout: ['Veena', 'Carnatic violin', 'Carnatic vocal'],
};

const steps = [
  {
    title: 'Talk to the instructors',
    text: 'Tell us who will be learning, how old they are and whether they have played before. We will suggest a good place to begin.',
  },
  {
    title: 'Choose a class and timing',
    text: 'Pick veena, violin or vocal, and we will find a time that works for your family.',
  },
  {
    title: 'Begin at your own pace',
    text: 'Lessons start where the student is and move forward as their confidence grows.',
  },
];

const faqs = [
  {
    question: 'Can a complete beginner learn the veena?',
    answer: 'Yes, of course. We teach all ages and levels, and we begin with a friendly conversation about where to start.',
  },
  {
    question: 'Are classes online or in person?',
    answer: 'Both. We prefer to teach online, and we also have a school in Kovaipudur, Coimbatore for in-person lessons. Vocal and violin have weekend sessions. Tell us your instrument and the timings that suit you, and we will see what we can arrange.',
  },
  {
    question: 'Can I join from another city?',
    answer: 'Yes. Since we teach online, you can join from another city.',
  },
  {
    question: 'Do you teach violin and vocal as well?',
    answer: 'Yes. Along with the veena, we teach Carnatic violin and vocal, with weekend sessions.',
  },
  {
    question: 'How much do the classes cost?',
    answer: 'Fees depend on how many classes a student needs and their level. Theory classes, held twice a month, are optional and charged separately. Message us and we will share the current fees.',
  },
  {
    question: 'Where are the classes held?',
    answer: 'Our school is in Kovaipudur, Coimbatore. Message us on WhatsApp and we will send you the exact location.',
  },
];
---

<BaseLayout title={title} description={description} jsonLd={[schoolSchema]}>
  <section class="border-b border-line bg-brand-soft">
    <Container size="wide" class="grid items-center gap-10 py-14 md:grid-cols-2 md:py-20">
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-link">
          Online veena classes
        </p>
        <h1 class="text-4xl font-semibold leading-tight text-ink sm:text-5xl">
          Online veena classes for children and adults
        </h1>
        <p class="mt-4 max-w-xl text-xl text-ink">
          Learn the veena from the comfort of your home.
        </p>
        <ul class="mt-4 space-y-1.5">
          {heroPoints.map((point) => (
            <li class="flex items-center gap-2.5 text-muted">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-surface text-link">
                <point.icon size={16} aria-hidden="true" />
              </span>
              {point.text}
            </li>
          ))}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={whatsappLink(whatsappMessages.general)} external size="lg">
            <MessageCircle size={17} aria-hidden="true" /> WhatsApp us
          </Button>
          <Button href="/courses/veena/" variant="secondary" size="lg">Veena classes</Button>
        </div>
      </div>

      <ImagePlaceholder
        prompt="A young student seated cross-legged at home playing a Saraswati veena, a laptop on a low stool showing the teacher on a video call, a brass lamp glowing nearby, warm sandal-orange and charcoal palette on ivory, calm and respectful mood, illustrated editorial style, no text, no logos"
        width={1200}
        height={900}
        aspect="4/3"
        loading="eager"
      />
    </Container>
  </section>

  <section class="py-16 md:py-20">
    <Container size="wide">
      <SectionHeading
        title="Our classes"
        lead="Veena is our main class, and we also teach Carnatic violin and vocal. Not sure which to choose? Message us and we will help you decide."
      />
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {courses.map((course) => (
          <div class:list={[course.primary && 'md:col-span-2']}>
            <CourseCard course={course} />
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section class="border-y border-line bg-sunken py-16 md:py-20">
    <Container size="wide">
      <SectionHeading
        title="Learning at Achyutha"
        lead="Carnatic music is learned slowly, with a teacher who listens. We try to make that easy for the whole family."
      />
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {whyPoints.map((point) => (
          <div class="rounded-2xl border border-line bg-surface p-6">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-soft text-link">
              <point.icon size={22} aria-hidden="true" />
            </span>
            <h3 class="mt-4 text-lg font-semibold text-ink">{point.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{point.text}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section class="py-16 md:py-20">
    <Container size="narrow">
      <SectionHeading
        eyebrow="Our guru"
        title={`In the tradition of ${site.guru}`}
        lead="Sri S.V. Achyutha Iyer was a violinist who taught sangathis, the little variations that give a Carnatic song its character. The school grew from his teaching."
      />
      <ul class="mt-8 space-y-5">
        <li class="rounded-2xl border border-line bg-surface p-6">
          <h3 class="text-lg font-semibold text-ink">Jayanthi Ravichandran</h3>
          <p class="mt-2 leading-relaxed text-muted">
            Trained for about ten years under {site.guru}, then continued with the veena artists
            Pudukkottai Krishnamurthy and Smt. Padma Krishnamurthy.
          </p>
        </li>
        <li class="rounded-2xl border border-line bg-surface p-6">
          <h3 class="text-lg font-semibold text-ink">Dr. Divya C.R.</h3>
          <p class="mt-2 leading-relaxed text-muted">
            A performer and teacher of Carnatic vocal and violin with over twenty years of
            experience.
          </p>
        </li>
      </ul>
      <p class="mt-8">
        <Button href="/team/" variant="ghost">Meet all our teachers</Button>
      </p>
    </Container>
  </section>

  <section class="border-y border-line bg-brand-soft py-16 md:py-20">
    <Container size="wide">
      <SectionHeading title="How to get started" align="center" />
      <ol class="mt-10 grid gap-6 md:grid-cols-3">
        {steps.map((step, index) => (
          <li class="rounded-2xl border border-line bg-surface p-6">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand font-semibold text-brand-on">
              {index + 1}
            </span>
            <h3 class="mt-4 text-lg font-semibold text-ink">{step.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{step.text}</p>
          </li>
        ))}
      </ol>
    </Container>
  </section>

  <section class="py-16 md:py-20">
    <Container size="narrow">
      <SectionHeading title="Questions you may have" />
      <div class="mt-8">
        <Faq items={faqs} />
      </div>
      <p class="mt-6 text-muted">
        You can read more on our <a href="/fees-enrollment/">fees and enrolment page</a>.
      </p>
    </Container>
  </section>

  <section class="px-4 pb-4 sm:px-6">
    <Container size="wide" class="rounded-3xl bg-header px-6 py-12 text-center text-header-text md:py-16">
      <h2 class="text-3xl font-semibold sm:text-4xl">Come and say hello</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed opacity-85">
        Send us a message and tell us who will be learning. We will help you choose a class
        and a timing that suits you.
      </p>
      <div class="mt-8 flex justify-center">
        <Button href={whatsappLink(whatsappMessages.general)} external size="lg">
          <MessageCircle size={18} aria-hidden="true" /> Message us on WhatsApp
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>
