---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import defaultShareImage from '../assets/images/home-veena.png';
import { site } from '../config/site';
import { pageTitle, canonicalUrl } from '../utils/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppNudge from '../components/WhatsAppNudge.astro';

interface Props {
  title?: string;
  description?: string;
  /** Hide from search engines (for example the 404 page). */
  noindex?: boolean;
  /** Structured data objects to add to the page as JSON-LD. */
  jsonLd?: Record<string, unknown>[];
  /** Photo shown when the page is shared on WhatsApp or social media. */
  image?: ImageMetadata;
  /** Short description of the share photo. */
  imageAlt?: string;
}

const {
  title,
  description = `${site.name} teaches the veena online, with Carnatic violin and vocal lessons as well.`,
  noindex = false,
  jsonLd = [],
  image = defaultShareImage,
  imageAlt = 'A student playing the veena at home during an online lesson',
} = Astro.props;

const fullTitle = pageTitle(title);
const canonical = canonicalUrl(Astro.url.pathname);

// A 1200 by 630 crop of the page photo, the size link previews expect.
const share = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const shareUrl = new URL(share.src, site.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1c191a" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {jsonLd.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    <!-- Apply the saved theme before first paint to avoid a flash. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var dark =
            saved === 'dark' ||
            (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-ground font-sans text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-md focus:bg-brand focus:px-4 focus:py-2 focus:text-brand-on"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppNudge />
  </body>
</html>
