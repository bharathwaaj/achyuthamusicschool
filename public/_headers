# Response headers, applied by Cloudflare to the static files in dist/.

# Built files carry a content hash in their names, so they never change
# and browsers can keep them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The workers.dev address serves the same pages as the real domain. Keep
# it out of search results so the two do not compete.
https://achyuthamusicschool.bharathwaaj-s.workers.dev/*
  X-Robots-Tag: noindex
